{
  "scriptFile": "__init__.py",
  "bindings": [{
      "name": "myblob",
      "type": "blobTrigger",
      "direction": "in",
      "path": "source/{name}",
      "connection":"MyStorageConnectionAppSetting"
        },
    {
      "name": "inputblob",
      "type": "blob",
      "dataType": "binary",
      "path": "source/{name}",
      "connection": "MyStorageConnectionAppSetting",
      "direction": "in"
    },
    {
      "name": "outputblob",
      "type": "blob",
      "dataType": "binary",
      "path": "function-releases/{name}",
      "connection": "MyStorageConnectionAppSetting",
      "direction": "out"
    }
  ]
}